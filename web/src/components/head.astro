---
import "../styles/output.css";
import { Font } from "astro:assets";

interface Props {
  title?: string;
}

const { title = "bill bickerstaff" } = Astro.props;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <Font cssVariable="--font-beowolf" />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/favicon_io_face/apple-touch-icon.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href="/favicon_io_face/favicon-32x32.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href="/favicon_io_face/favicon-16x16.png"
  />
  <link rel="manifest" href="/favicon_io/site.webmanifest" />
</head>
